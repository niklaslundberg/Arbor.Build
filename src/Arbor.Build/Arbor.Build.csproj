<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained Condition="'${Configuration}' == 'release'">true</SelfContained>
    <RuntimeIdentifiers Condition="'${Configuration}' == 'release'">win-x64;linux-x64</RuntimeIdentifiers>
    <OutputType>Exe</OutputType>
    <PublishSingleFile Condition="'${Configuration}' == 'release'">false</PublishSingleFile>
    <PackAsTool>true</PackAsTool>
    <PackageId>Arbor.Build.Tool</PackageId>
    <ToolCommandName>arbor-build</ToolCommandName>
	<ArborPublishEnabled>true</ArborPublishEnabled>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="Microsoft.Win32.Primitives" Condition="'${RuntimeIdentifier}' == 'win-x64'" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Condition="'${Configuration}' == 'release'">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arbor.Build.Core\Arbor.Build.Core.csproj" />
  </ItemGroup>

</Project>
