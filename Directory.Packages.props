<Project>
  <!-- Enable central package management only for projects that are not standalone sample projects.
       Note: This condition must live here (not in Directory.Build.props) because Directory.Packages.props
       is imported *after* Directory.Build.props in the MSBuild evaluation order, so only conditions
       placed here take effect for the ManagePackageVersionsCentrally property. -->
  <PropertyGroup Condition="!$([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('/samples/_')) And !$([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('\samples\_'))">
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Arbor.Aesculus" Version="3.9.0" />
    <PackageVersion Include="Arbor.FileSystem" Version="0.6.0" />
    <PackageVersion Include="Arbor.KVConfiguration.Core" Version="3.0.0" />
    <PackageVersion Include="Arbor.KVConfiguration.JsonConfiguration" Version="3.0.0" />
    <PackageVersion Include="Arbor.KVConfiguration.Schema.Json" Version="3.0.0" />
    <PackageVersion Include="Arbor.KVConfiguration.UserConfiguration" Version="3.0.0" />
    <PackageVersion Include="Arbor.Processing" Version="0.6.0" />
    <PackageVersion Include="Arbor.Sorbus" Version="4.0.0" />
    <PackageVersion Include="Arbor.Tooler" Version="1.2.0" />
    <PackageVersion Include="Autofac" Version="9.1.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.0" />
    <PackageVersion Include="coverlet.msbuild" Version="10.0.0" />
    <PackageVersion Include="JetBrains.Annotations" Version="2025.2.4" />
    <PackageVersion Include="Machine.Specifications" Version="1.1.3" />
    <PackageVersion Include="Machine.Specifications.Runner.VisualStudio" Version="2.10.2" />
    <PackageVersion Include="Machine.Specifications.Should" Version="1.0.0" />
    <PackageVersion Include="Meziantou.Xunit.v3.ParallelTestFramework" Version="1.0.6" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.202" />
    <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <PackageVersion Include="Microsoft.Web.Xdt" Version="3.2.6" />
    <PackageVersion Include="Microsoft.Win32.Primitives" Version="4.3.0" />
    <PackageVersion Include="Microsoft.Windows.Compatibility" Version="10.0.6" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.2.1" />
    <PackageVersion Include="NCrunch.Framework" Version="5.11.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="NUnit" Version="4.5.1" />
    <PackageVersion Include="NuGet.Packaging" Version="7.3.1" />
    <PackageVersion Include="NuGet.Protocol" Version="7.3.1" />
    <PackageVersion Include="NuGet.Versioning" Version="7.3.1" />
    <PackageVersion Include="Serilog" Version="4.3.1" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.0.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.6" />
    <PackageVersion Include="xunit.analyzers" Version="1.27.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="Zio" Version="0.22.2" />
  </ItemGroup>
</Project>
