<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- Test Execution Settings -->
  <RunConfiguration>
    <!-- Number of processors to use when running tests in parallel -->
    <MaxCpuCount>0</MaxCpuCount>
    <!-- Disable in-process parallelization if you want to run tests sequentially -->
    <DisableParallelization>false</DisableParallelization>
    <!-- Set the base directory for test execution -->
    <ResultsDirectory>.\TestResults</ResultsDirectory>
    <!-- Timeout for each test in milliseconds (0 = no timeout) -->
    <TestSessionTimeout>0</TestSessionTimeout>
    <!-- Enable discovery of all test frameworks -->
    <DiscoverInternalTests>true</DiscoverInternalTests>
    <!-- Custom test host environment variables for WSL and cross-platform -->
    <EnvironmentVariables>
      <!-- Enable WSL test execution -->
      <WSL_ENABLED>true</WSL_ENABLED>
      <WSL_DISTRIBUTION>Ubuntu</WSL_DISTRIBUTION>
      <!-- .NET configuration for cross-platform testing -->
      <DOTNET_SKIP_FIRST_TIME_EXPERIENCE>true</DOTNET_SKIP_FIRST_TIME_EXPERIENCE>
      <DOTNET_CLI_TELEMETRY_OPTOUT>true</DOTNET_CLI_TELEMETRY_OPTOUT>
    </EnvironmentVariables>
  </RunConfiguration>

  <!-- Logger Configuration -->
  <LoggerRunSettings>
    <!-- Verbosity for console logger: quiet, minimal, normal, detailed, verbose -->
    <Verbosity>normal</Verbosity>
  </LoggerRunSettings>

  <!-- Test Adapter Paths for discovering test adapters from NuGet packages -->
  <TestAdapterPaths>
    <!-- Discover adapters from all subdirectories -->
    <Directory path="." includeSubDirectories="true" />
  </TestAdapterPaths>

  <!-- xUnit v3 Adapter Settings -->
  <xUnit>
    <!-- Set parallel strategy: collections, assemblies, or none -->
    <ParallelizeAssembly>true</ParallelizeAssembly>
    <ParallelizeTestCollections>true</ParallelizeTestCollections>
    <!-- Max degree of parallelism (0 = # of processors) -->
    <MaxParallelThreads>0</MaxParallelThreads>
    <!-- Discover inline test data (theories with InlineData) -->
    <PreEnumerateTheories>false</PreEnumerateTheories>
    <!-- Enable diagnostic messages for troubleshooting -->
    <InternalDiagnosticMessages>false</InternalDiagnosticMessages>
    <!-- Enable discovery of all xUnit test types -->
    <ShadowCopy>false</ShadowCopy>
    <!-- Use app domains (false for .NET Core) -->
    <UseAppDomains>false</UseAppDomains>
  </xUnit>

  <!-- MSTest Adapter Settings -->
  <MSTest>
    <!-- Enable parallel test execution -->
    <Parallelize workers="0" scope="MethodLevel" />
    <!-- Test isolation: none, method, class, assembly -->
    <TestIsolation>method</TestIsolation>
    <!-- Capture trace output -->
    <CaptureTraceOutput>true</CaptureTraceOutput>
    <!-- Enable test discovery for all test attributes -->
    <ForcedLegacyMode>false</ForcedLegacyMode>
    <!-- MapNotExecutedTo: Executed, NotExecuted, NotRunnable, Inconclusive, Unknown -->
    <MapNotExecutedTo>NotRunnable</MapNotExecutedTo>
    <!-- Enable discovery of internal test classes -->
    <EnableBaseClassTestMethodsFromOtherAssemblies>true</EnableBaseClassTestMethodsFromOtherAssemblies>
    <!-- Test discovery timeout in ms -->
    <AssemblyResolutionTimeout>10000</AssemblyResolutionTimeout>
  </MSTest>

  <!-- NUnit Adapter Settings (if using NUnit) -->
  <NUnit>
    <!-- Number of test workers for NUnit -->
    <NumberOfTestWorkers>-1</NumberOfTestWorkers>
    <!-- Use all available processors -->
    <MaxParallelThreads>0</MaxParallelThreads>
  </NUnit>

  <!-- Machine.Specifications Adapter Settings -->
  <MSpec>
    <!-- Enable parallel execution -->
    <Parallelize>true</Parallelize>
  </MSpec>

  <!-- Blame Configuration (for diagnosing hung tests) -->
  <InProcDataCollectionRunSettings>
    <InProcDataCollectors>
      <InProcDataCollector friendlyName="blame" enabled="false">
        <Configuration>
          <CollectDump processName="testhost" />
        </Configuration>
      </InProcDataCollector>
    </InProcDataCollectors>
  </InProcDataCollectionRunSettings>

  <!-- Code Coverage Settings (optional) -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage" uri="datacollector://Microsoft/CodeCoverage/2.0" enabled="false">
        <Configuration>
          <CodeCoverage>
            <!-- Bit flags: 0 = None, 1 = Calls, 2 = LinesCovered, 4 = LinesNotCovered -->
            <ModulePaths>
              <ModulePath>.*</ModulePath>
            </ModulePaths>
            <!-- Modules to exclude from code coverage -->
            <ModuleExclusions>
              <ModuleExclusion>.*xunit.*</ModuleExclusion>
              <ModuleExclusion>.*nunit.*</ModuleExclusion>
              <ModuleExclusion>.*mspec.*</ModuleExclusion>
            </ModuleExclusions>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
